{
  "name": "leadzam-click-to-call-backend",
  "version": "1.0.0",
  "description": "Small API that turns a CRM 'Call' click into an FCM message for an Android device",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:mock": "set FCM_MODE=mock&& node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0"
  }
}
