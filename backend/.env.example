# Copy to `.env` (which is git-ignored) and fill in.

PORT=3000

# "live" sends real FCM messages (needs Firebase credentials below).
# "mock" never calls Firebase - useful to try the dashboard without a Firebase project.
FCM_MODE=live

# --- Firebase Admin credentials (choose ONE) -------------------------------
# Option A: path to the service-account JSON you downloaded from
#   Firebase console > Project settings > Service accounts > Generate new private key
# Keep the file OUTSIDE git. backend/secrets/ is git-ignored for this reason.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Option B: the whole JSON as one line (handy on hosting platforms)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# --- Optional: hard-code the demo device token ------------------------------
# Normally the Android app registers itself (POST /api/device) or you paste the
# token into the dashboard. This is only a fallback.
# DEVICE_FCM_TOKEN=
